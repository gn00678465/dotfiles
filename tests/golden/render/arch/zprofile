# mise shims for non-interactive login shells (see mise docs: shims for
# non-interactive, `mise activate` for interactive).
# ~/.local/bin is NOT on the default login PATH, so prepend it before probing.
export PATH="$HOME/.local/bin:$PATH"

# On brew platforms mise lives under the brew prefix, so this block has to
# come before the mise probe below.
# omarchy: same env-bootstrap as .zshrc, so login shells (ssh, zsh -l) also
# find OMARCHY_PATH, omarchy-* and the mise shims.
[ -r /etc/omarchy.conf ] && . /etc/omarchy.conf
: "${OMARCHY_PATH:=/usr/share/omarchy}"
[ -r "$OMARCHY_PATH/default/bash/env-bootstrap" ] && . "$OMARCHY_PATH/default/bash/env-bootstrap"
if (( $+commands[mise] )); then
  eval "$(mise activate zsh --shims)"
fi

# /etc/profile and every line above assign the PATH string, and `typeset -U`
# drops duplicates only when the path array is assigned. The first copy wins,
# as in command lookup, so no command resolves differently.
typeset -U path
path=($path)
