# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# ---- PATH ---------------------------------------------------------------
export PATH="$HOME/.local/bin:$PATH"


# omarchy: OMARCHY_PATH and PATH come from its own env-bootstrap (POSIX sh
# syntax, so zsh can source it). Its bash-only rc file is deliberately not loaded.
[ -r /etc/omarchy.conf ] && . /etc/omarchy.conf
: "${OMARCHY_PATH:=/usr/share/omarchy}"
[ -r "$OMARCHY_PATH/default/bash/env-bootstrap" ] && . "$OMARCHY_PATH/default/bash/env-bootstrap"

# A login shell has already run the same PATH setup in .zprofile. See there
# for why the array has to be reassigned.
typeset -U path
path=($path)

# ---- Oh My Zsh ----------------------------------------------------------
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"
# fzf-tab must come before zsh-autosuggestions/zsh-syntax-highlighting: those
# wrap ZLE widgets, and fzf-tab has to wrap them first.
plugins=(git mise fzf-tab zsh-autosuggestions zsh-syntax-highlighting)
# chezmoi owns the OMZ version via .chezmoiexternal.toml refreshPeriod.
zstyle ':omz:update' mode disabled
source "$ZSH/oh-my-zsh.sh"

# mise is NOT activated here: the OMZ `mise` plugin above already runs
# `mise activate zsh` and additionally wires up completions. The plugin bails
# out early if mise is not already on PATH, and on brew platforms mise lives
# under the brew prefix, which is why the PATH block has to precede oh-my-zsh.sh.

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# Per-machine settings live outside chezmoi so apply/update never overwrite them.
# Keep it last so it can override anything above; the `||` form keeps the exit
# status 0 when the file is absent, otherwise p10k shows the first prompt as failed.
[[ ! -f ~/.zshrc.local ]] || source ~/.zshrc.local
