{{- $p := includeTemplate "platform.toml" . | fromToml -}}
{{- $isWSL := false -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   if hasKey .chezmoi "kernel" -}}
{{-     if contains "microsoft" (lower .chezmoi.kernel.osrelease) -}}
{{-       $isWSL = true -}}
{{-     end -}}
{{-   end -}}
{{- end -}}

{{/* `chezmoi init --source=DIR` does not persist DIR: a later bare
     `chezmoi apply` would fall back to ~/.local/share/chezmoi and fail. For the
     normal clone this is just the default, written out explicitly. */}}
{{- if hasKey .chezmoi "sourceDir" }}
sourceDir = {{ .chezmoi.sourceDir | quote }}
{{- end }}

[data]
    isWSL = {{ $isWSL }}
{{ if $p.isWindows -}}
{{/* Bypass 只作用在 chezmoi 為自己的腳本開的那個 process，不改機器的原則，也不需要
     系統管理員。信任邊界是這個 source repo，不是 execution policy。

     -NoProfile：chezmoi 的預設 args 只有 -NoLogo -File，於是安裝腳本會載入使用者的
     pwsh profile —— 也就是這個 repo 自己裝的那一份（oh-my-posh、PSFzf、mise）。
     安裝腳本的行為不該取決於使用者的 profile；POSIX 那邊沒有這個問題，因為 chezmoi
     本來就不走互動 shell。

     command 明寫 pwsh 而不是沿用預設：預設值是 chezmoi 的實作細節，而這幾支腳本都是
     `#Requires -Version 7`，用 Windows PowerShell 5.1 跑一定失敗。 */}}
# chezmoi 把 .ps1 寫到 %TEMP% 再交給直譯器跑。全新 Windows 的預設 ExecutionPolicy
# 是 Restricted，而 pwsh 7 一樣受它管，於是第一支腳本就以「running scripts is
# disabled on this system」拒載，整個 apply 在任何檔案落地前中止。
[interpreters.ps1]
    command = "pwsh"
    args = ["-NoLogo", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File"]
{{ end -}}
