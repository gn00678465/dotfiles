{{ if or (eq .chezmoi.os "linux") (eq .chezmoi.os "darwin") -}}
# mise shims for non-interactive login shells (see mise docs: shims for
# non-interactive, `mise activate` for interactive).
# ~/.local/bin is NOT on the default login PATH, so prepend it before probing.
export PATH="$HOME/.local/bin:$PATH"

# mise is installed by brew, so brew has to come first. `typeset -U path` keeps
# the entries unique when .zshrc runs shellenv again for interactive shells.
typeset -U path
{{ if eq .chezmoi.os "darwin" -}}
eval "$({{ if eq .chezmoi.arch "arm64" }}/opt/homebrew{{ else }}/usr/local{{ end }}/bin/brew shellenv)"
{{ else if eq .chezmoi.os "linux" -}}
eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
{{ end -}}

if (( $+commands[mise] )); then
  eval "$(mise activate zsh --shims)"
fi
{{ end -}}
