#   | #!/bin/sh
#   | # End-to-end check inside a throwaway Linux environment (test layer L9, the
#   | # POSIX half of tests/sandbox/_probe.ps1).
#   | #
#   | # The sandbox is the only place a real install is allowed to run: the host is
