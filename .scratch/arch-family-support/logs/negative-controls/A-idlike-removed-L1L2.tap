#   expected blank (chezmoi 才會跳過這支腳本)
#   --- actual ---
#   | #!/bin/zsh
#   | # brew packages shared by Linux and macOS. Add new tools here, not to
#   | # 10-install-packages (apt, Linux only).
#   | set -euo pipefail
#   | 
#   | eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
#   | 
#   | # Homebrew 6 made ask mode the default, so a bare `brew install` stops at
#   | # "Do you want to proceed with the installation? [y/n]". chezmoi runs this
#   | # unattended. The env var is preferred over `-y`: older Homebrew ignores an
#   | # unknown variable but would abort on an unknown flag.
#   | export HOMEBREW_NO_ASK=1
#   | 
#   | # tree-sitter-cli, not tree-sitter: since 0.27 the `tree-sitter` formula ships
#   | # only libtree-sitter and the CLI lives in `tree-sitter-cli`. nvim-treesitter
#   | # needs the CLI. Without it on PATH LazyVim falls back to mason's GitHub
#   | # prebuilt binary, which wants glibc 2.39 and fails on Debian 12 (2.36); the
#   | # brew bottle runs against brew's own glibc, so it works there.
#   | for formula in mise fzf git-lfs ripgrep fd lazygit tree-sitter-cli; do
#   |   brew list --formula "$formula" &>/dev/null || brew install "$formula"
#   | done
