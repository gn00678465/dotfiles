{{- $p := includeTemplate "platform.toml" . | fromToml -}}
{{ if eq $p.os "linux" -}}
#!/bin/sh
# OS-level prerequisites only: zsh/git/curl plus what the Homebrew installer
# needs on Linux. Everything else (fzf, mise, git-lfs, ...) is a brew formula
# in 30-install-brew-packages so the list is shared with macOS.
set -eu

missing=""
for pkg in zsh git curl build-essential procps file; do
    if ! dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q '^install ok installed$'; then
        missing="$missing $pkg"
    fi
done
if [ -z "$missing" ]; then
    exit 0
fi

echo "chezmoi: installing missing packages:$missing"
if [ "$(id -u)" -eq 0 ]; then
    apt-get update && apt-get install -y $missing
elif command -v sudo >/dev/null 2>&1; then
    # Prime the sudo credential cache first: fails fast and loudly with no tty,
    # instead of hanging or half-installing.
    if ! sudo -v; then
        echo "chezmoi: sudo authentication failed. Run: sudo apt-get install -y$missing" >&2
        exit 1
    fi
    sudo apt-get update && sudo apt-get install -y $missing
else
    echo "chezmoi: sudo not available. Run as root: apt-get install -y$missing" >&2
    exit 1
fi
{{ end -}}
