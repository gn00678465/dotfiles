{{- $p := includeTemplate "platform.toml" . | fromToml -}}
{{ if $p.isPosix -}}
#!/bin/zsh
# `git lfs install` is a `git config --global` write. It must run AFTER files
# are applied: create_empty_dot_gitconfig guarantees ~/.gitconfig exists by
# then, so git writes there and not into chezmoi-owned ~/.config/git/config.
# That is also why [filter "lfs"] is deliberately absent from that file.
set -euo pipefail

eval "$({{ $p.brewPrefix }}/bin/brew shellenv)"

if ! command -v git-lfs &>/dev/null; then
  exit 0
fi

# --skip-repo: only write the global filter config, never touch the cwd repo.
git lfs install --skip-repo >/dev/null
{{ end -}}
