{{- $p := includeTemplate "platform.toml" . | fromToml -}}
{{- $v := includeTemplate "versions.toml" . | fromToml -}}
{{ if $p.isPosix -}}
#!/bin/zsh
# gitleaks through mise's aqua backend (aqua verifies the release checksum).
# mise writes it into the global ~/.config/mise/config.toml:
#   [tools]  "aqua:gitleaks/gitleaks" = "<version>"
# `run_` like 55-cc-statusline: a removed tool comes back on the next apply.
set -euo pipefail
{{ if ne $p.brewPrefix "" }}
eval "$({{ $p.brewPrefix }}/bin/brew shellenv)"
{{- end }}

if ! command -v mise &>/dev/null; then
  echo "chezmoi: mise not found, skipping gitleaks" >&2
  exit 0
fi

# `yes` is a mise setting, not a flag on `use`; chezmoi runs this unattended.
export MISE_YES=1
mise use --global 'aqua:gitleaks/gitleaks@{{ $v.gitleaks }}'
{{ end -}}
