{{- $brewPrefix := "/home/linuxbrew/.linuxbrew" -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $brewPrefix = "/opt/homebrew" -}}
{{-   if ne .chezmoi.arch "arm64" -}}
{{-     $brewPrefix = "/usr/local" -}}
{{-   end -}}
{{- end -}}
#!/bin/zsh
# Neovim (via mise) + the LazyVim starter config.
# `before`, because `git clone` refuses a non-empty target and chezmoi owns
# files *inside* ~/.config/nvim (private_dot_config/nvim/...). The starter has
# to land first; chezmoi then writes our overrides on top of it.
set -euo pipefail

eval "$({{ $brewPrefix }}/bin/brew shellenv)"

if ! command -v mise &>/dev/null; then
  echo "chezmoi: mise not found, skipping neovim" >&2
  exit 0
fi

# `yes` is a mise setting, not a flag on `use`; the env var form is the one
# that is guaranteed to work here, and chezmoi runs this unattended.
export MISE_YES=1

# Writes neovim = "0.12.5" to ~/.config/mise/config.toml and installs it.
#
# Pinned rather than @latest, for two risks the other tools here do not carry:
#   - mise installs neovim's *official prebuilt* Linux binary, built on
#     ubuntu-22.04 (glibc 2.35). Debian 11 (2.31) cannot run it; 12 and 13 can.
#     That floor rises whenever neovim's CI moves to a newer runner.
#   - nvim-treesitter's `main` branch -- the one LazyVim tracks -- has already
#     tightened its minimum neovim version mid-flight once and broke installs
#     (LazyVim#7092). LazyVim guards against "too old", not against "too new".
# So bumping this is a deliberate act: re-read the Requirements sections of
# nvim-treesitter `main` and LazyVim first.
# Background: docs/research/nvim-treesitter-mise-lazyvim-debian-errors.md
mise use --global neovim@0.12.5

# The LazyVim starter is a template, not a tracked dependency: clone it once and
# drop its .git. Whatever chezmoi does not explicitly own under
# private_dot_config/nvim/ is then the user's to edit in place -- nothing here
# is `exact`, so chezmoi will not delete or revert it.
nvim_config="${XDG_CONFIG_HOME:-$HOME/.config}/nvim"
if [[ ! -d $nvim_config ]]; then
  echo "chezmoi: cloning the LazyVim starter into $nvim_config"
  git clone --depth 1 https://github.com/LazyVim/starter "$nvim_config"
  rm -rf "$nvim_config/.git"
fi
